{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrumo audio generation adapter",
  "description": "Generates music or sound effects from a written prompt with an HTTPS API that takes a JSON POST and returns the audio file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginId", "credentialSetting", "credentialHeader", "credentialPrefix", "responseFormat", "kinds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pluginId": { "$ref": "#/$defs/id" },
    "credentialSetting": { "$ref": "#/$defs/id" },
    "credentialHeader": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "credentialPrefix": { "enum": ["", "Bearer "] },
    "responseFormat": { "enum": ["mp3", "wav"] },
    "kinds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "music": { "$ref": "#/$defs/kind", "description": "Requires the music-generation capability." },
        "sound-effect": { "$ref": "#/$defs/kind", "description": "Requires the sound-effect-generation capability." }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "promptField", "durationField", "durationUnit", "minSeconds", "maxSeconds", "maxPromptCharacters", "body", "query"],
      "properties": {
        "endpoint": { "type": "string", "maxLength": 2048, "pattern": "^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~-]+)+$" },
        "promptField": { "$ref": "#/$defs/key" },
        "durationField": { "$ref": "#/$defs/key" },
        "durationUnit": { "enum": ["seconds", "milliseconds"] },
        "minSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "maxSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "maxPromptCharacters": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "body": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "maxLength": 256 },
              { "type": "boolean" },
              { "type": "number" }
            ]
          }
        },
        "query": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": { "type": "string", "maxLength": 256 }
        }
      }
    }
  }
}
