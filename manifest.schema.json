{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrumo plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "agentProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "setupUrl",
        "cli"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 80
        },
        "setupUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "authStatusArgs"
          ],
          "properties": {
            "executable": {
              "$ref": "#/$defs/identifier"
            },
            "authStatusArgs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    }
  },
  "dependentSchemas": {
    "agentProvider": {
      "properties": {
        "capabilities": {
          "required": [
            "agents"
          ]
        }
      }
    }
  }
}
