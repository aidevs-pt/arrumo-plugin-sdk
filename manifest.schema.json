{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrumo plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "agentProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "setupUrl",
        "cli"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 80
        },
        "setupUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "authStatusArgs"
          ],
          "properties": {
            "executable": {
              "$ref": "#/$defs/identifier"
            },
            "authStatusArgs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "structuredRun": {
              "description": "Runs the agent once, non-interactively, with the prompt on stdin and a JSON Schema the answer must follow. Placeholders must be whole arguments: {schema} is the schema as JSON, {schemaPath} a file containing it, {outputPath} a file the agent writes its answer to, and {settings} the arguments chosen by settingArgs.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "args",
                "result"
              ],
              "properties": {
                "args": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "items": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 512
                  }
                },
                "settingArgs": {
                  "description": "Arguments that follow the plugin's settings, inserted in order at the {settings} placeholder. Boolean settings use args when true and otherwise when false. Other settings use args when they have a value, replacing {value} inside each argument with it; string values must come from the setting's choices.",
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "setting",
                      "args"
                    ],
                    "properties": {
                      "setting": {
                        "$ref": "#/$defs/identifier"
                      },
                      "args": {
                        "type": "array",
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "maxLength": 256
                        }
                      },
                      "otherwise": {
                        "type": "array",
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "maxLength": 256
                        }
                      }
                    }
                  }
                },
                "imageArgs": {
                  "description": "Arguments that attach one image the agent can look at, repeated for each image at the {images} placeholder; {imagePath} is replaced with the image's file. Omit when the agent cannot take images.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "progress": {
                  "description": "Patterns that turn lines the agent prints while it works into steps the host can show: what it is thinking about, what it searches for, or other steps. A pattern's first capture group is the step's text; without one, label is used.",
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "pattern",
                      "kind"
                    ],
                    "properties": {
                      "pattern": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "kind": {
                        "enum": [
                          "thinking",
                          "search",
                          "step"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  }
                },
                "result": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "source": {
                      "enum": [
                        "outputFile",
                        "stdout"
                      ],
                      "description": "Where the JSON answer appears."
                    },
                    "pointer": {
                      "type": "string",
                      "pattern": "^(/[^/]+)*$",
                      "maxLength": 128,
                      "description": "JSON Pointer to the answer inside the document. Omit when the document is the answer."
                    },
                    "errorPointer": {
                      "type": "string",
                      "pattern": "^(/[^/]+)+$",
                      "maxLength": 128,
                      "description": "JSON Pointer to a boolean that is true when the agent reports failure."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "code": {
      "$ref": "#/$defs/code"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "kind",
        "scope",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "secret"
          ]
        },
        "scope": {
          "enum": [
            "app",
            "workspace"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "choices": {
          "description": "For string settings: the only values allowed, shown as a choice list.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
          }
        },
        "default": {
          "description": "The value used when neither the app nor the workspace sets one. Not allowed for secrets.",
          "type": [
            "string",
            "boolean",
            "integer"
          ]
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component"
          ],
          "properties": {
            "component": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?:(?!\\.(1, 2)/)[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]*\\.wasm$"
            },
            "permissions": {
              "type": "array",
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "const": "workspace-context-read"
              }
            }
          }
        },
        "frontend": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "document",
              "placement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "document": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^(?:(?!\\.(1, 2)/)[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]*\\.html$"
              },
              "placement": {
                "enum": [
                  "settings",
                  "workspace",
                  "completed_video"
                ]
              },
              "permissions": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "const": "workspace-context-read"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "permissions"
                  ],
                  "properties": {
                    "permissions": {
                      "minItems": 1
                    }
                  }
                },
                "then": {
                  "properties": {
                    "placement": {
                      "enum": [
                        "workspace",
                        "completed_video"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "backend"
          ]
        },
        {
          "required": [
            "frontend"
          ],
          "properties": {
            "frontend": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "scope": {
          "enum": [
            "app",
            "workspace"
          ]
        }
      }
    }
  },
  "dependentSchemas": {
    "agentProvider": {
      "properties": {
        "capabilities": {
          "required": [
            "agents"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "settings"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              2,
              3,
              4,
              5,
              6,
              7
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              3,
              4,
              5,
              6,
              7
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "required": [
              "backend"
            ],
            "properties": {
              "backend": {
                "required": [
                  "permissions"
                ],
                "properties": {
                  "permissions": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              4,
              5,
              6,
              7
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "required": [
              "frontend"
            ],
            "properties": {
              "frontend": {
                "contains": {
                  "required": [
                    "permissions"
                  ],
                  "properties": {
                    "permissions": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              5,
              6,
              7
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "actions"
        ]
      },
      "then": {
        "required": [
          "code"
        ],
        "properties": {
          "schemaVersion": {
            "const": 6
          },
          "code": {
            "required": [
              "backend"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              1,
              2,
              3,
              4,
              5,
              6
            ]
          }
        }
      },
      "then": {
        "properties": {
          "agentProvider": {
            "properties": {
              "cli": {
                "not": {
                  "required": [
                    "structuredRun"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
