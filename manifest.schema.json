{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrumo plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "agentProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "setupUrl",
        "cli"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 80
        },
        "setupUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "authStatusArgs"
          ],
          "properties": {
            "executable": {
              "$ref": "#/$defs/identifier"
            },
            "authStatusArgs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "code": {
      "$ref": "#/$defs/code"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "kind",
        "scope",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "secret"
          ]
        },
        "scope": {
          "enum": [
            "app",
            "workspace"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component"
          ],
          "properties": {
            "component": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?:(?!\\.(1, 2)/)[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]*\\.wasm$"
            },
            "permissions": {
              "type": "array",
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "const": "workspace-context-read"
              }
            }
          }
        },
        "frontend": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "document",
              "placement"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "document": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^(?:(?!\\.(1, 2)/)[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]*\\.html$"
              },
              "placement": {
                "enum": [
                  "settings",
                  "workspace",
                  "completed_video"
                ]
              },
              "permissions": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "const": "workspace-context-read"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "permissions"
                  ],
                  "properties": {
                    "permissions": {
                      "minItems": 1
                    }
                  }
                },
                "then": {
                  "properties": {
                    "placement": {
                      "enum": [
                        "workspace",
                        "completed_video"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "backend"
          ]
        },
        {
          "required": [
            "frontend"
          ],
          "properties": {
            "frontend": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "scope": {
          "enum": [
            "app",
            "workspace"
          ]
        }
      }
    }
  },
  "dependentSchemas": {
    "agentProvider": {
      "properties": {
        "capabilities": {
          "required": [
            "agents"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "settings"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              2,
              3,
              4,
              5,
              6
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              3,
              4,
              5,
              6
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "required": [
              "backend"
            ],
            "properties": {
              "backend": {
                "required": [
                  "permissions"
                ],
                "properties": {
                  "permissions": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              4,
              5,
              6
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "required": [
              "frontend"
            ],
            "properties": {
              "frontend": {
                "contains": {
                  "required": [
                    "permissions"
                  ],
                  "properties": {
                    "permissions": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "enum": [
              5,
              6
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "actions"
        ]
      },
      "then": {
        "required": [
          "code"
        ],
        "properties": {
          "schemaVersion": {
            "const": 6
          },
          "code": {
            "required": [
              "backend"
            ]
          }
        }
      }
    }
  ]
}
