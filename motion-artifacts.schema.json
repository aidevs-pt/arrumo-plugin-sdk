{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrumo motion artifact submission",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/artifact"
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000]+$"
    },
    "optionalPath": {
      "anyOf": [
        {
          "$ref": "#/$defs/absolutePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "usage_markdown",
        "preview"
      ],
      "properties": {
        "kind": {
          "enum": [
            "animation",
            "transition"
          ]
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "usage_markdown": {
          "type": "string"
        },
        "profile_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "preview": {
          "$ref": "#/$defs/absolutePath"
        },
        "thumbnail": {
          "$ref": "#/$defs/optionalPath"
        },
        "sound": {
          "$ref": "#/$defs/optionalPath"
        }
      }
    }
  }
}
